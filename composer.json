{
    "name": "hexagonlabsllc/laravel-exports",
    "description": "Comprehensive export feature that utilizes Laravel's model backbone to create customizable exports.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.12||^13.0",
        "illuminate/contracts": "^12.12||^13.0",
        "illuminate/database": "^12.12||^13.0",
        "illuminate/console": "^12.12||^13.0",
        "illuminate/bus": "^12.12||^13.0",
        "illuminate/queue": "^12.12||^13.0",
        "illuminate/http": "^12.12||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^10.0.0||^11.0.0",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0",
        "phpstan/extension-installer": "^1.3||^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0"
    },
    "autoload": {
        "psr-4": {
            "HexagonLabsLLC\\LaravelExports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HexagonLabsLLC\\LaravelExports\\Tests\\": "tests/"
        },
        "files": [
            "tests/phpstan-bootstrap.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "HexagonLabsLLC\\LaravelExports\\LaravelExportsServiceProvider"
            ],
            "aliases": {
                "LaravelExports": "HexagonLabsLLC\\LaravelExports\\Facades\\LaravelExports"
            }
        }
    },
    "authors": [
        {
            "name": "Robert",
            "email": "rklitsch@hexlabs.ai",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/HexagonLabsLLC/laravel-exports",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
